# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — SERVER ONLY, never expose to client
# Found in: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL — set to your Vercel deployment URL in production (e.g. https://fleet-manager.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Capacitor iOS — URL loaded in the native WebView (defaults to crownfleet.vercel.app in capacitor.config.ts)
# For device testing against local Next.js: CAPACITOR_SERVER_URL=http://YOUR_LAN_IP:3000 npm run cap:sync
CAPACITOR_SERVER_URL=

# Optional: Cloud import integrations
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required when cloud import integrations are enabled — encrypts OAuth access
# tokens before they are stored in cookies. Use a long random string, e.g.
# `openssl rand -base64 48`. Without it, provider tokens are not persisted.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Optional: health checks and alerting
# If set, callers must send Authorization: Bearer <token> to /api/health
HEALTHCHECK_TOKEN=
# Incoming webhook URL for degraded health alerts (Slack/Teams/PagerDuty, etc.)
ALERT_WEBHOOK_URL=

# Resend (used by Supabase Auth for signup/password reset emails when configured)
RESEND_API_KEY=
